{
  "manifest_version": 3,
  "name": "Clicktrail \u2014 clickable walkthroughs",
  "version": "0.1.0",
  "description": "Capture a screen, mark a click, export an offline interactive walkthrough.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-step": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture a step"
    }
  }
}
